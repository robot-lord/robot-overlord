#!/usr/bin/env bash
# Block pushing a branch that doesn't bump the version (CI checks the same on
# PRs). Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000

# Compares against the local origin/main ref (no fetch, so pushes stay fast;
# a stale ref only makes the check more lenient — CI has the final say).
git rev-parse -q --verify origin/main >/dev/null || exit 0
[[ -f xtask/src/bump.rs ]] || exit 0  # branch predates the check

# Built once, on the first branch that needs checking. Not --locked
# (unlike the `cargo xtask` alias): a stale Cargo.lock must reach the
# check, which reports it. If xtask can't build (no cargo, offline on a
# fresh clone), skip: CI checks.
built=0
status=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue              # branch deletion
  [[ "$remote_ref" == refs/heads/* ]] || continue          # tags etc.
  [[ "$remote_ref" == refs/heads/main ]] && continue       # main itself
  # Nothing beyond main yet (e.g. a fresh branch): nothing to check.
  [[ -z "$(git rev-list -n1 "origin/main..$local_sha")" ]] && continue
  echo "pre-push: checking version bump for ${local_ref#refs/heads/}" >&2
  if [[ $built == 0 ]]; then
    cargo build -q --package xtask ||
      { echo "pre-push: couldn't build xtask; version bump not checked (CI will)" >&2; exit 0; }
    built=1
  fi
  cargo run -q --package xtask -- check-version-bump origin/main "$local_sha" >&2 || status=1
done
exit $status
