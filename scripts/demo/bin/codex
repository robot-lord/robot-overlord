#!/usr/bin/env bash
# A stand-in for the Codex CLI in rlord's demo (scripts/demo/demo.sh): draws
# a plausible session screen, writes a rollout and a row in Codex's thread
# index under $CODEX_HOME, and reports its state through rlord's hooks like
# the real thing. Never talks to a model.
#
# No hooks for a session with a file $RLORD_DEMO_DIR/nohooks/<folder name>,
# as when rlord's hooks aren't trusted in Codex yet (rlord then follows the
# thread index and the rollout).
#
# Without --no-daemon it plays a thread on Codex's shared background
# server: its hooks run without the pane's RLORD_SESSION_ID / TMUX_PANE (as
# the daemon's do), and the index lists it as an app-server client's.
# `codex app-server daemon version|start` answer as the real one does.
set -u
demo=${RLORD_DEMO_DIR:?}
home=${CODEX_HOME:?}
if [[ ${1:-} == app-server && ${2:-} == daemon ]]; then
  case ${3:-} in
    start) mkdir -p "$home" && touch "$home/stand-in-daemon" ;;
    version) ;;
    *) echo "the stand-in knows only daemon version|start" >&2; exit 2 ;;
  esac
  st=stopped; [[ -e $home/stand-in-daemon ]] && st=running
  printf '{"status":"%s","backend":"pid","socketPath":"%s/app-server-control/app-server-control.sock","cliVersion":"0.167.2","appServerVersion":"0.169.0"}\n' "$st" "$home"
  exit 0
fi
args=("$@")
tid='' prompt='' exec=0 out='' sub='' daemon=1
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[$i]} in
    exec) exec=1 ;;
    --no-daemon) daemon=0 ;;
    resume | fork) sub=${args[$i]}; tid=${args[$((i + 1))]}; i=$((i + 1)) ;;
    -m | --model | -c | --config | -s | --sandbox) i=$((i + 1)) ;;
    -o | --output-last-message) out=${args[$((i + 1))]}; i=$((i + 1)) ;;
    -*) ;;
    *) prompt=${args[$i]} ;;
  esac
done
key=$(basename "$PWD")

# `codex exec` (archive summaries): the prepared summary, into the -o file.
if [[ $exec == 1 ]]; then
  [[ $sub == fork ]] && key=$(basename "$(sqlite3 "$home/state_5.sqlite" "select cwd from threads where id='$tid'" 2>/dev/null)")
  text=$(cat "$demo/summaries/$key.txt" 2>/dev/null || echo "A demo session.")
  if [[ -n $out ]]; then printf '%s\n' "$text" >"$out"; else printf '%s\n' "$text"; fi
  exit 0
fi

now() { python3 -c 'import datetime; print(datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z")'; }
mkdir -p "$home"
db=$home/state_5.sqlite
sqlite3 "$db" "create table if not exists threads (id text primary key, rollout_path text not null, cwd text not null, title text not null default '', created_at_ms integer, updated_at_ms integer, thread_source text, model text, source text not null default 'cli', first_user_message text not null default '')"
if [[ $sub == resume ]]; then
  tr=$(sqlite3 "$db" "select rollout_path from threads where id='$tid'")
  [[ -n $tr ]] || { echo "No saved session found with ID $tid" >&2; exit 1; }
else
  tid=$(python3 -c 'import uuid; print(uuid.uuid4())')
  day=$home/sessions/$(date -u +%Y/%m/%d)
  mkdir -p "$day"
  tr=$day/rollout-$(date -u +%Y-%m-%dT%H-%M-%S)-$tid.jsonl
  ms=$(python3 -c 'import time; print(int(time.time() * 1000))')
  python3 -c 'import json,sys; print(json.dumps({"timestamp": sys.argv[1], "type": "session_meta", "payload": {"id": sys.argv[2], "cwd": sys.argv[3], "originator": "codex-tui", "cli_version": "0.167.2"}}))' \
    "$(now)" "$tid" "$PWD" >"$tr"
  # (The first prompt, as Codex records it: quotes doubled for SQL.)
  first=$(printf '%s' "$prompt" | sed "s/'/''/g")
  source=cli; [[ $daemon == 1 ]] && source=vscode
  sqlite3 "$db" "insert into threads (id, rollout_path, cwd, title, created_at_ms, updated_at_ms, thread_source, model, source, first_user_message) values ('$tid', '$tr', '$PWD', '', $ms, $ms, 'user', 'gpt-6-luna', '$source', '$first')"
fi

hook() {
  [[ -e $demo/nohooks/$key ]] && return
  python3 -c 'import json,sys; print(json.dumps({"hook_event_name": sys.argv[1], "session_id": sys.argv[2], "transcript_path": sys.argv[3], "cwd": sys.argv[4]}))' \
    "$1" "$tid" "$tr" "$PWD" | {
      if [[ $daemon == 1 ]]; then
        env -u RLORD_SESSION_ID -u TMUX_PANE rlord hook emit codex
      else
        rlord hook emit codex
      fi
    } >/dev/null 2>&1 || true
}
# line TYPE PAYLOAD-JSON: one rollout line.
line() { python3 -c 'import json,sys; print(json.dumps({"timestamp": sys.argv[1], "type": sys.argv[2], "payload": json.loads(sys.argv[3])}))' "$(now)" "$1" "$2" >>"$tr"; }
msg() { python3 -c 'import json,sys; print(json.dumps({"type": "message", "role": sys.argv[1], "content": [{"type": sys.argv[2], "text": sys.argv[3]}]}))' "$1" "$2" "$3"; }

screen=$demo/screens/$key.txt
state=$(cat "$demo/states/$key" 2>/dev/null || echo idle)
hook SessionStart
if [[ $sub != resume ]]; then
  line event_msg '{"type": "task_started", "turn_id": "t1"}'
  line response_item "$(msg user input_text "<environment_context><cwd>$PWD</cwd></environment_context>")"
  line turn_context '{"turn_id": "t1", "model": "gpt-6-luna"}'
  # Earlier turns, as far as $demo/usage/<folder> ("TURNS CONTEXT") says
  # it has got (the list's Usage column reads them), then the latest.
  turns=1 ctx=18000
  [[ -r $demo/usage/$key ]] && read -r turns ctx <"$demo/usage/$key"
  for ((t = 1; t < turns; t++)); do
    line response_item "$(msg user input_text "$([[ $t == 1 ]] && echo "${prompt:-continue}" || echo "keep going")")"
    line response_item "$(msg assistant output_text "Done; on to the next part.")"
    c=$((12000 + (ctx - 12000) * t / turns))
    line event_msg "{\"type\": \"token_count\", \"info\": {\"total_token_usage\": {\"input_tokens\": $((c * t)), \"cached_input_tokens\": $((c * t * 4 / 5)), \"output_tokens\": $((t * 700))}, \"last_token_usage\": {\"input_tokens\": $c, \"output_tokens\": 700}, \"model_context_window\": 272000}}"
  done
  line response_item "$(msg user input_text "$([[ $turns == 1 ]] && echo "${prompt:-continue}" || echo "finish up")")"
  hook UserPromptSubmit
  if [[ $state != working ]]; then
    line response_item "$(msg assistant output_text "$(sed -n 's/^• //p' "$screen" 2>/dev/null | head -n 3 | tr '\n' ' ')")"
    line event_msg "{\"type\": \"token_count\", \"info\": {\"total_token_usage\": {\"input_tokens\": $((ctx * turns)), \"cached_input_tokens\": $((ctx * turns * 4 / 5)), \"output_tokens\": $((turns * 700))}, \"last_token_usage\": {\"input_tokens\": $ctx, \"output_tokens\": 700}, \"model_context_window\": 272000}}"
    line event_msg '{"type": "task_complete", "turn_id": "t1"}'
    hook Stop
    [[ $state == waiting ]] && hook PermissionRequest
  fi
fi
# (On the daemon the thread outlives its client: no SessionEnd when the
# pane goes.)
if [[ $daemon == 1 ]]; then trap 'exit 0' TERM HUP INT; else trap 'hook SessionEnd; exit 0' TERM HUP INT; fi
clear
cat "$screen" 2>/dev/null
while :; do sleep 3600 & wait $!; done
