#!/usr/bin/env bash
# A stand-in for Claude Code in rlord's demo (scripts/demo/demo.sh): draws a
# plausible session screen, writes a small transcript, and reports its state
# through rlord's hooks like the real thing. Never talks to a model.
set -u
demo=${RLORD_DEMO_DIR:?}
args=("$@")
sid='' prompt='' print=0 overlord=''
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[$i]} in
    --session-id | --resume) sid=${args[$((i + 1))]}; i=$((i + 1)) ;;
    --model | --effort | --settings | --remote-control | --allowedTools | --append-system-prompt | --tools | --output-format) i=$((i + 1)) ;;
    --mcp-config) overlord=${args[$((i + 1))]}; i=$((i + 1)) ;;
    -p | --print) print=1 ;;
    -*) ;;
    *) prompt=${args[$i]} ;;
  esac
done
key=$(basename "$PWD")

# `claude -p` (archive summaries): answer with the prepared summary.
if [[ $print == 1 ]]; then
  text=$(cat "$demo/summaries/$key.txt" 2>/dev/null || echo "A demo session.")
  python3 -c 'import json,sys; print(json.dumps({"result": sys.argv[1], "is_error": False, "session_id": "demo"}))' "$text"
  exit 0
fi

slug=$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')
tdir=${CLAUDE_CONFIG_DIR:?}/projects/$slug
mkdir -p "$tdir"
tr=$tdir/$sid.jsonl
hook() {
  python3 -c 'import json,sys; print(json.dumps({"hook_event_name": sys.argv[1], "session_id": sys.argv[2], "transcript_path": sys.argv[3]}))' \
    "$1" "$sid" "$tr" | rlord hook emit claude >/dev/null 2>&1 || true
}
# say PROMPT REPLY: the conversation so far. How far it has got comes from
# $demo/usage/<folder> ("TURNS CONTEXT", written by demo.sh): that many
# prompts, each answered with token usage, the last request sending about
# CONTEXT tokens (the list's Usage column reads these).
say() {
  local turns=1 ctx=18000
  [[ -r $demo/usage/$key ]] && read -r turns ctx <"$demo/usage/$key"
  python3 - "$tr" "$1" "$2" "$turns" "$ctx" <<'PY'
import json, sys
tr, first, reply, turns, ctx = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), int(sys.argv[5])
asks = ["keep going", "looks good, next step", "run the tests again", "fix that and continue"]
with open(tr, "a") as f:
    for i in range(turns):
        f.write(json.dumps({"type": "user", "timestamp": "2026-01-01T00:00:00Z",
            "message": {"role": "user", "content": first if i == 0 else asks[i % len(asks)]}}) + "\n")
        c = 12000 + (ctx - 12000) * (i + 1) // turns
        f.write(json.dumps({"type": "assistant", "timestamp": "2026-01-01T00:00:05Z",
            "message": {"id": f"msg_demo{i}", "model": "claude-opus-5-5", "role": "assistant",
                        "content": [{"type": "text", "text": reply if i == turns - 1 else "Done; on to the next part."}],
                        "usage": {"input_tokens": 4, "cache_creation_input_tokens": c // 6,
                                  "cache_read_input_tokens": c - c // 6, "output_tokens": 900}}}) + "\n")
PY
}

if [[ -n $overlord ]]; then
  screen=$demo/screens/overlord.txt
  state=idle
else
  screen=$demo/screens/$key.txt
  state=$(cat "$demo/states/$key" 2>/dev/null || echo idle)
fi
[[ -s $tr ]] || say "${prompt:-continue}" "$(sed -n 's/^● //p' "$screen" 2>/dev/null | head -n 3 | tr '\n' ' ')"
hook SessionStart
hook UserPromptSubmit
case $state in
  waiting) hook Stop; hook Notification ;;
  idle) hook Stop ;;
esac
clear
cat "$screen" 2>/dev/null
while :; do sleep 3600; done
