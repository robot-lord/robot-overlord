#!/usr/bin/env bash
# A stand-in for OpenCode (v2) in rlord's demo (scripts/demo/demo.sh): draws
# a plausible session screen and writes the session into an OpenCode
# database under $XDG_DATA_HOME, as the real one's background server would.
# Never talks to a model, and runs no server: with none to listen to, rlord
# reads working / your turn from the session's row (so the demo can't show
# an OpenCode session that "needs you").
set -u
demo=${RLORD_DEMO_DIR:?}
data=${XDG_DATA_HOME:?}/opencode
db=$data/opencode.db
args=("$@")
sid='' prompt='' sub='' fork=0 archived=0 body=''
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[$i]} in
    --version | -v) echo "opencode v2.2.7"; exit 0 ;;
    models) printf '%s\n' opencode/deepseek-v4.1-flash-free opencode/glm-5.3-flash-free anthropic/claude-sonnet-5; exit 0 ;;
    run) sub=run ;;
    api) sub=api ;;
    -d | --data) body=${args[$((i + 1))]}; i=$((i + 1)) ;;
    session) sub=session ;;
    delete) [[ $sub == session ]] && sub=delete ;;
    -s | --session) sid=${args[$((i + 1))]}; i=$((i + 1)) ;;
    --prompt) prompt=${args[$((i + 1))]}; i=$((i + 1)) ;;
    -m | --model | --agent | --format | --title) i=$((i + 1)) ;;
    --fork) fork=1 ;;
    --archived) archived=1 ;;
    -*) ;;
    *) case $sub in delete) sid=${args[$i]} ;; api) ;; *) prompt=${args[$i]} ;; esac ;;
  esac
done

mkdir -p "$data"
sql() { sqlite3 "$db" "$@"; }
sql "create table if not exists session_v2 (id text primary key, project_id text not null default 'demo', parent_id text, fork_session_id text, directory text not null, title text, tokens_input integer not null default 0, tokens_output integer not null default 0, model text, time_created integer not null, time_updated integer not null, time_busy integer, time_idle integer, time_archived integer);
     create table if not exists session_message (id text primary key, session_id text not null, type text not null, seq integer not null, time_created integer not null, time_updated integer not null, data text not null);"
ms() { python3 -c 'import time; print(int(time.time() * 1000))'; }
# message SESSION TYPE JSON: the next row of a session.
message() {
  local now seq
  now=$(ms)
  seq=$(sql "select coalesce(max(seq), 0) + 3 from session_message where session_id='$1'")
  python3 - "$db" "$1" "$2" "$seq" "$now" "$3" <<'PY'
import sqlite3, sys
db, sid, kind, seq, now, data = sys.argv[1:]
c = sqlite3.connect(db)
c.execute("insert into session_message values (?, ?, ?, ?, ?, ?, ?)",
          (f"msg_{sid[4:]}{seq}", sid, kind, int(seq), int(now), int(now), data))
c.execute("update session_v2 set time_updated = ? where id = ?", (int(now), sid))
c.commit()
PY
}
user() { message "$1" user "$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1], "files": [], "agents": []}))' "$2")"; }
# reply SESSION TEXT [CONTEXT]: the agent's answer, sending CONTEXT tokens.
reply() {
  local ctx=${3:-14023}
  message "$1" assistant "$(python3 -c 'import json,sys; print(json.dumps({"agent": "build", "model": {"id": "deepseek-v4.1-flash-free", "providerID": "opencode"}, "content": [{"type": "text", "text": sys.argv[1]}], "finish": "stop", "tokens": {"input": int(sys.argv[2]) // 5, "output": 212, "reasoning": 0, "cache": {"read": int(sys.argv[2]) - int(sys.argv[2]) // 5, "write": 0}}}))' "$2" "$ctx")"
  sql "update session_v2 set tokens_input = tokens_input + $((ctx / 5)), tokens_output = tokens_output + 212 where id='$1'"
}
create() { # ID [FORK-OF]
  local now
  now=$(ms)
  sql "insert or ignore into session_v2 (id, directory, title, model, time_created, time_updated, fork_session_id, time_archived) values ('$1', '$PWD', '', '{\"id\":\"deepseek-v4.1-flash-free\",\"providerID\":\"opencode\"}', $now, $now, $([[ -n ${2:-} ]] && echo "'$2'" || echo null), $([[ $archived == 1 ]] && echo "$now" || echo null))"
}

case $sub in
  api)
    # `api POST /api/session -d {id, location, model}`: what a launch runs
    # first, so the session exists (with its model) before its screen.
    python3 - "$db" "$body" <<'PY'
import json, sqlite3, sys, time
db, body = sys.argv[1:]
b = json.loads(body)
now = int(time.time() * 1000)
model = b.get("model") or {"id": "deepseek-v4.1-flash-free", "providerID": "opencode"}
c = sqlite3.connect(db)
c.execute("insert or ignore into session_v2 (id, directory, title, model, time_created, time_updated) values (?, ?, '', ?, ?, ?)",
          (b["id"], b["location"]["directory"], json.dumps(model), now, now))
c.commit()
PY
    exit 0
    ;;
  delete)
    sql "delete from session_message where session_id='$sid'; delete from session_v2 where id='$sid'"
    echo "Session $sid deleted"
    exit 0
    ;;
  run)
    # An archive summary: the prepared one, as the answer of a throwaway
    # session (a fork of the session, or one of its own).
    key=$(basename "$PWD")
    if [[ $fork == 1 ]]; then
      key=$(basename "$(sql "select directory from session_v2 where id='$sid'")")
      own=ses_$(python3 -c 'import uuid; print(uuid.uuid4().hex[:26])')
      create "$own" "$sid"
    else
      own=$sid
      create "$own"
    fi
    text=$(cat "$demo/summaries/$key.txt" 2>/dev/null || echo "A demo session.")
    user "$own" "$prompt"
    reply "$own" "$text"
    printf '%s\n' "$text"
    exit 0
    ;;
esac

[[ -n $sid ]] || { echo "the demo's opencode needs -s <session id>" >&2; exit 1; }
key=$(basename "$PWD")
screen=$demo/screens/$key.txt
state=$(cat "$demo/states/$key" 2>/dev/null || echo idle)
# (The real screen creates a missing session only with its first message.)
[[ -n $prompt ]] && create "$sid"
if [[ -z $(sql "select id from session_message where session_id='$sid' limit 1") ]]; then
  if [[ -n $prompt ]]; then
    # Earlier turns, as far as $demo/usage/<folder> ("TURNS CONTEXT") says
    # it has got (the list's Usage column reads them), then the latest.
    turns=1 ctx=14023
    [[ -r $demo/usage/$key ]] && read -r turns ctx <"$demo/usage/$key"
    for ((t = 1; t < turns; t++)); do
      user "$sid" "$([[ $t == 1 ]] && echo "$prompt" || echo "keep going")"
      reply "$sid" "Done; on to the next part." $((12000 + (ctx - 12000) * t / turns))
    done
    user "$sid" "$([[ $turns == 1 ]] && echo "$prompt" || echo "finish up")"
    sql "update session_v2 set time_busy = $(ms) where id='$sid'"
    if [[ $state != working ]]; then
      reply "$sid" "$(sed -n 's/^• //p' "$screen" 2>/dev/null | head -n 3 | tr '\n' ' ')" "$ctx"
      sql "update session_v2 set time_idle = $(ms) + 1 where id='$sid'"
    fi
  fi
fi
trap 'exit 0' TERM HUP INT
clear
cat "$screen" 2>/dev/null
while :; do sleep 3600 & wait $!; done
