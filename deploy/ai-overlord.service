# systemd user unit for the AI Overlord daemon.
# Install:
#   cargo install --path crates/overlord
#   mkdir -p ~/.config/systemd/user && cp deploy/ai-overlord.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now ai-overlord
# `loginctl enable-linger $USER` if it should run without an active login session.

[Unit]
Description=AI Overlord daemon (overlordd)
After=default.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/overlord daemon
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
