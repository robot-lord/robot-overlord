# systemd unit for rlord-relay, from the release tarball:
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin rlord-relay
#   install -m 0755 rlord-relay /usr/local/bin/rlord-relay
#   install -d -m 0755 /etc/rlord-relay
#   install -m 0644 relay.toml.example /etc/rlord-relay/relay.toml   # then edit it
#   install -m 0644 rlord-relay.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now rlord-relay
#
# systemd makes /var/lib/rlord-relay (StateDirectory), owned by that user.
# Run admin commands as the same user, so the database files they touch
# stay the service's:
#
#   sudo -u rlord-relay rlord-relay token new
#
# Works in either TLS mode. In files mode (:443) the certificate files must
# be readable by the user: for example a deploy hook that copies them to
# /etc/rlord-relay, the key with mode 0640 and group rlord-relay. `systemctl
# reload rlord-relay` re-reads them.
[Unit]
Description=rlord relay (rlord-relay)
Documentation=https://github.com/robot-lord/robot-overlord/blob/main/docs/relay.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStartPre=/usr/local/bin/rlord-relay --config /etc/rlord-relay/relay.toml check
ExecStart=/usr/local/bin/rlord-relay --config /etc/rlord-relay/relay.toml serve
# SIGHUP re-reads the certificate files (files mode).
ExecReload=kill -HUP $MAINPID
# Not on-failure: systemd counts an exit by SIGHUP, SIGINT or SIGTERM as
# clean, and a relay should come back from those too.
Restart=always
RestartSec=2
Environment=RUST_LOG=info

User=rlord-relay
Group=rlord-relay
StateDirectory=rlord-relay
StateDirectoryMode=0700
# Binding :443 in files mode, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
LimitNOFILE=65536

# Hardening: the relay needs its state folder, its config and the network.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077

[Install]
WantedBy=multi-user.target
